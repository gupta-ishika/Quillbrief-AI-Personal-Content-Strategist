# AI Personal Content Strategist - Environment Configuration Example
# Copy this file to .env and fill in your values.
# IMPORTANT: .env must NEVER be committed to version control.

# --- YouTube & Platform Credentials ---
# Required for public video and comment data lookup.
# Stored only in .env and read at startup.
YOUTUBE_API_KEY=

# Optional: Google OAuth for owner-only YouTube analytics (read-only scopes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/youtube/callback

# --- Encryption ---
# Fernet 32 url-safe base64-encoded key for encrypting OAuth refresh tokens at rest.
# Generate in Python via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=

# --- Server & Security ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Storage & Databases ---
DATABASE_URL=sqlite:///./app.db
CHECKPOINTS_DATABASE_URL=sqlite:///./checkpoints.db

# --- Ollama & Local AI Models ---
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3.5:4b
EMBEDDING_MODEL=nomic-embed-text

# --- First-Run Brief & Strategy Defaults ---
# Used only to seed settings when no row exists; saved settings always take precedence.
DEFAULT_BRIEF_DAY=mon
DEFAULT_BRIEF_TIME=08:00
DEFAULT_TIME_ZONE=Asia/Kolkata
DEFAULT_DEPTH_LEVEL=standard
